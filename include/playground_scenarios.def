/*
 * Single source of truth for playground scenarios.
 *
 * Columns: enum identifier, command-line name, evidence kind, description.
 * The file is consumed by C and by the corpus validation scripts.
 */
P101_SCENARIO(SCENARIO_TOUR, "tour", P101_SCENARIO_EXECUTABLE_CLEAN, "Clean default: file + realloc + pipe + fork")
P101_SCENARIO(SCENARIO_ORIENTATION, "orientation", P101_SCENARIO_EXECUTABLE_CLEAN, "First p101 tour: env, err, wrappers, and tools")
P101_SCENARIO(SCENARIO_CLEAN_FILE, "clean-file", P101_SCENARIO_EXECUTABLE_CLEAN, "Open/write/close/free cleanly")
P101_SCENARIO(SCENARIO_REALLOC, "realloc", P101_SCENARIO_EXECUTABLE_CLEAN, "Allocate, grow, and free a block")
P101_SCENARIO(SCENARIO_PIPE, "pipe", P101_SCENARIO_EXECUTABLE_CLEAN, "Create a pipe and close both descriptors")
P101_SCENARIO(SCENARIO_FORK, "fork", P101_SCENARIO_EXECUTABLE_CLEAN, "Fork a child that uses heap + pipe resources")
P101_SCENARIO(SCENARIO_FD_LEAK, "fd-leak", P101_SCENARIO_EXECUTABLE_DEFECT, "Intentionally leak one descriptor")
P101_SCENARIO(SCENARIO_ALLOC_LEAK, "alloc-leak", P101_SCENARIO_EXECUTABLE_DEFECT, "Intentionally leak one allocation")
P101_SCENARIO(SCENARIO_DOUBLE_CLOSE, "double-close", P101_SCENARIO_EXECUTABLE_DEFECT, "Intentionally close one descriptor twice")
P101_SCENARIO(SCENARIO_STRAY_CLOSE, "stray-close", P101_SCENARIO_EXECUTABLE_DEFECT, "Intentionally close an unopened positive descriptor")
P101_SCENARIO(SCENARIO_FAULT_LAB, "fault-lab", P101_SCENARIO_EXECUTABLE_DEFECT, "Clean normally, leaky under injected p101 failures")
P101_SCENARIO(SCENARIO_EARLY_RETURN_FD_LEAK, "early-return-fd-leak", P101_SCENARIO_EXECUTABLE_DEFECT, "Return before descriptor cleanup")
P101_SCENARIO(SCENARIO_EARLY_RETURN_ALLOC_LEAK, "early-return-alloc-leak", P101_SCENARIO_EXECUTABLE_DEFECT, "Return before allocation cleanup")
P101_SCENARIO(SCENARIO_PARTIAL_CLEANUP, "partial-cleanup", P101_SCENARIO_EXECUTABLE_DEFECT, "Acquire several resources and clean up only some")
P101_SCENARIO(SCENARIO_REALLOC_LEAK, "realloc-leak", P101_SCENARIO_EXECUTABLE_DEFECT, "Grow an allocation and forget to free the result")
P101_SCENARIO(SCENARIO_EXEC_INHERIT, "exec-inherit", P101_SCENARIO_EXECUTABLE_DEFECT, "Leave a descriptor open across an exec boundary")
P101_SCENARIO(SCENARIO_DOUBLE_FREE, "double-free", P101_SCENARIO_EXECUTABLE_DEFECT, "Emit a deterministic double-release event")
P101_SCENARIO(SCENARIO_STRAY_FREE, "stray-free", P101_SCENARIO_EXECUTABLE_DEFECT, "Emit a deterministic invalid-release event")
P101_SCENARIO(SCENARIO_SIZEOF_POINTER, "sizeof-pointer", P101_SCENARIO_EXECUTABLE_DEFECT, "Use sizeof(pointer) where the data size was needed")
P101_SCENARIO(SCENARIO_IGNORE_READ_COUNT, "ignore-read-count", P101_SCENARIO_EXECUTABLE_DEFECT, "Write a whole buffer instead of the bytes read")
P101_SCENARIO(SCENARIO_UNSAFE_LOG_SECRET, "unsafe-log-secret", P101_SCENARIO_MODELED_DEFECT, "Model a secret written into an application log")
P101_SCENARIO(SCENARIO_LOG_INJECTION, "log-injection", P101_SCENARIO_MODELED_DEFECT, "Model untrusted text forging a second log record")
P101_SCENARIO(SCENARIO_MISSING_STRUCTURED_LOG, "missing-structured-log", P101_SCENARIO_MODELED_DEFECT, "Model vague text instead of structured event fields")
P101_SCENARIO(SCENARIO_INPUT_VALIDATION, "input-validation", P101_SCENARIO_MODELED_DEFECT, "Model an unsafe path-shaped input value")
P101_SCENARIO(SCENARIO_COMMAND_INJECTION, "command-injection", P101_SCENARIO_MODELED_DEFECT, "Model a shell command built from untrusted text")
P101_SCENARIO(SCENARIO_PREDICTABLE_TEMP_FILE, "predictable-temp-file", P101_SCENARIO_MODELED_DEFECT, "Model a predictable filename in /tmp")
P101_SCENARIO(SCENARIO_SIGNED_CONVERSION, "signed-conversion", P101_SCENARIO_EXECUTABLE_DEFECT, "Convert a negative count to an unsigned size")
P101_SCENARIO(SCENARIO_TRUNCATION, "truncation", P101_SCENARIO_EXECUTABLE_DEFECT, "Store a large value in a too-small integer type")
P101_SCENARIO(SCENARIO_USE_AFTER_FREE, "use-after-free", P101_SCENARIO_MODELED_DEFECT, "Model ownership use after free without invoking undefined behavior")
P101_SCENARIO(SCENARIO_REALLOC_FAILURE, "realloc-failure", P101_SCENARIO_MODELED_DEFECT, "Model losing the original pointer on failed growth")
