P101_SCENARIO(SCENARIO_BUFFER_OVERFLOW, "buffer-overflow", P101_SCENARIO_MODELED_DEFECT, "Model a copy larger than its destination")
P101_SCENARIO(SCENARIO_UNINITIALIZED_READ, "uninitialized-read", P101_SCENARIO_MODELED_DEFECT, "Model using a value before initialization")
P101_SCENARIO(SCENARIO_NULL_DEREFERENCE, "null-dereference", P101_SCENARIO_MODELED_DEFECT, "Model continuing after a NULL result")
P101_SCENARIO(SCENARIO_INTEGER_OVERFLOW, "integer-overflow", P101_SCENARIO_MODELED_DEFECT, "Model an allocation-size calculation wrapping")
P101_SCENARIO(SCENARIO_PATH_TRAVERSAL, "path-traversal", P101_SCENARIO_MODELED_DEFECT, "Model a path escaping its intended root")
P101_SCENARIO(SCENARIO_FORMAT_STRING, "format-string", P101_SCENARIO_MODELED_DEFECT, "Model user text used as a printf format")
P101_SCENARIO(SCENARIO_STALE_SECRET, "stale-secret", P101_SCENARIO_MODELED_DEFECT, "Model secret bytes surviving buffer reuse")
P101_SCENARIO(SCENARIO_RESOURCE_EXHAUSTION, "resource-exhaustion", P101_SCENARIO_MODELED_DEFECT, "Model an unbounded resource request")
P101_SCENARIO(SCENARIO_TOCTOU, "toctou", P101_SCENARIO_MODELED_DEFECT, "Model a path check separated from later use")
P101_SCENARIO(SCENARIO_DATA_RACE, "data-race", P101_SCENARIO_MODELED_DEFECT, "Model shared state updated without synchronization")
P101_SCENARIO(SCENARIO_STRING_NOT_TERMINATED, "string-not-terminated", P101_SCENARIO_MODELED_DEFECT, "Model bytes used as a C string without a NUL terminator")
P101_SCENARIO(SCENARIO_PARTIAL_WRITE, "partial-write", P101_SCENARIO_MODELED_DEFECT, "Model a short write accepted as complete")
P101_SCENARIO(SCENARIO_INTERRUPTED_SYSCALL, "interrupted-syscall", P101_SCENARIO_MODELED_DEFECT, "Model EINTR treated as a final failure")
P101_SCENARIO(SCENARIO_UNSAFE_FILE_MODE, "unsafe-file-mode", P101_SCENARIO_MODELED_DEFECT, "Model a sensitive file created with broad permissions")
P101_SCENARIO(SCENARIO_SYMLINK_FOLLOW, "symlink-follow", P101_SCENARIO_MODELED_DEFECT, "Model following a symlink for a sensitive open")
P101_SCENARIO(SCENARIO_TRUSTED_ENVIRONMENT, "trusted-environment", P101_SCENARIO_MODELED_DEFECT, "Model trusting environment data for execution")
P101_SCENARIO(SCENARIO_UNCHECKED_PARSE, "unchecked-parse", P101_SCENARIO_MODELED_DEFECT, "Model accepting trailing junk after a numeric parse")
P101_SCENARIO(SCENARIO_MISSING_AUTHORIZATION, "missing-authorization", P101_SCENARIO_MODELED_DEFECT, "Model authentication without an authorization check")
P101_SCENARIO(SCENARIO_CLEANUP_ORDER, "cleanup-order", P101_SCENARIO_MODELED_DEFECT, "Model parent state destroyed before child state")
P101_SCENARIO(SCENARIO_THREAD_ARGUMENT_LIFETIME, "thread-argument-lifetime", P101_SCENARIO_MODELED_DEFECT, "Model a thread using an expired argument")
P101_SCENARIO(SCENARIO_SHORT_READ, "short-read", P101_SCENARIO_MODELED_DEFECT, "Model a short read accepted as a complete object")
P101_SCENARIO(SCENARIO_READ_EOF_HANDLING, "read-eof-handling", P101_SCENARIO_MODELED_DEFECT, "Model EOF confused with an I/O error")
P101_SCENARIO(SCENARIO_PARSER_FUZZ, "parser-fuzz", P101_SCENARIO_MODELED_DEFECT, "Model parser boundary cases without a fuzz target")
